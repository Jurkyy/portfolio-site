---
import DownloadFile from "./DownloadFile.astro";
---

<aside>
	<p>
		Prefer a traditional CV? Download the PDF, or
		<a class="mail" href="mailto:wolfbubberman+portfolio@gmail.com?subject=CV%20request">ask me</a>
		for the latest version.
	</p>
	<DownloadFile
		href="/assets/cv_wolfgang_bubberman.pdf"
		name="cv_wolfgang_bubberman.pdf"
		description="Download CV"
	/>
</aside>
<style>
	aside {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
		margin-top: 1.5rem;
		padding: 1.5rem;
		text-align: center;
		background: var(--glass-bg);
		border: 1px solid var(--glass-border);
		border-radius: var(--radius-lg);
		backdrop-filter: blur(var(--glass-blur));
		-webkit-backdrop-filter: blur(var(--glass-blur));
	}

	p {
		font-size: var(--text-md);
		color: var(--gray-200);
		max-width: 45ch;
	}

	.mail {
		color: var(--accent-secondary);
		text-underline-offset: 0.2em;
	}

	.mail:hover,
	.mail:focus {
		color: var(--accent-secondary-dark);
	}

	@media (min-width: 50em) {
		aside {
			flex-direction: row;
			justify-content: space-between;
			text-align: left;
			padding: 1.5rem 2rem;
		}
	}
</style>
